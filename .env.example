# npm run setup generates the local database password and JWT secret.
MYSQL_MANAGED_LOCAL=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=mediconnect
MYSQL_USER=mediconnect
MYSQL_PASSWORD=
JWT_SECRET=
BACKEND_PORT=4000
BACKEND_URL=http://127.0.0.1:4000/api/v1
FRONTEND_PORT=3000

# Configure private seed accounts before setup (passwords: 8-72 characters).
SEED_PATIENT_EMAIL=
SEED_PATIENT_PASSWORD=
SEED_DOCTOR_EMAIL=
SEED_DOCTOR_PASSWORD=
SEED_DOCTOR2_EMAIL=
SEED_DOCTOR2_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Existing MySQL: set MYSQL_MANAGED_LOCAL=false, provide connection settings,
# and create MYSQL_DATABASE before setup. Never commit a populated .env.
# MYSQL_SERVER_BINARY=C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqld.exe
