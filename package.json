{
  "name": "mediconnect-healthcare-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/offline.mjs dev",
    "start:dev": "npm run dev",
    "build": "npm run build --workspace backend && next build",
    "start": "node scripts/offline.mjs start",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck --workspace backend",
    "check": "npm run typecheck && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup": "npm run db:setup --workspace backend",
    "setup": "node scripts/setup-local.mjs",
    "db:export": "node scripts/export-schema.mjs",
    "test:api": "node scripts/test-api.mjs",
    "setup:testing": "node scripts/prepare-testing.mjs",
    "dev:offline": "node scripts/offline.mjs dev",
    "api:offline": "node scripts/offline.mjs api",
    "start:offline": "node scripts/offline.mjs start",
    "test:offline": "node scripts/offline.mjs test"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.0",
    "dotenv": "^17.0.0",
    "mysql2": "^3.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "workspaces": [
    "backend"
  ],
  "overrides": {
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  }
}
